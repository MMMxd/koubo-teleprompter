<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 步骤条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingTop="20dp">

        <TextView
            android:id="@+id/sn1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_pill_on"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lbl1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/step_lbl1"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/ln12"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:background="@color/border" />

        <TextView
            android:id="@+id/sn2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_pill_off"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lbl2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/step_lbl2"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <View
            android:id="@+id/ln23"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:background="@color/border" />

        <TextView
            android:id="@+id/sn3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_pill_off"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lbl3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/step_lbl3"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_off"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/btn_gen_topic_back"
            android:textColor="@color/text_sub"
            android:textSize="13sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/step1_title"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 第 1 步：简报 -->
    <ScrollView
        android:id="@+id/step1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- 热点借势条（从热点榜「写稿」带进来） -->
            <LinearLayout
                android:id="@+id/hsBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hotspot"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="13dp"
                android:paddingVertical="11dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥"
                    android:textSize="15px" />

                <TextView
                    android:id="@+id/hsText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="#FF8A5A00"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/hsClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="✕"
                    android:textColor="#FFB8B8C4"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pick_persona"
                android:textColor="@color/text_sub"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/personaRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/personaDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:padding="12dp"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/pick_platform"
                android:textColor="@color/text_sub"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/platformRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/pick_words"
                android:textColor="@color/text_sub"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/wordsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/rules"
                android:textColor="@color/text_sub"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rulesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/extraRule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:hint="@string/extra_rule_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:padding="13dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="@string/subject_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:padding="13dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 第 2 步：选方向 -->
    <ScrollView
        android:id="@+id/step2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/directionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnRegen"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_off"
                android:gravity="center"
                android:text="@string/btn_regenerate"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 第 3 步：成稿 -->
    <ScrollView
        android:id="@+id/step3Scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/draftTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/genStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/draft_generating"
                android:textColor="@color/primary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/draftContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:lineSpacingExtra="5dp"
                android:padding="14dp"
                android:textColor="@color/text_main"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部操作区（随步骤变化） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/topicStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/topic_generating"
            android:textColor="@color/primary"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <!-- 步骤1 底钮 -->
        <TextView
            android:id="@+id/btnTopics"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_grad_primary"
            android:gravity="center"
            android:text="@string/btn_topics"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 步骤2 底钮 -->
        <TextView
            android:id="@+id/btnRegenBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_grad_primary"
            android:gravity="center"
            android:text="@string/btn_gen_draft"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 步骤3 Dock -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnQuickPrompter"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_grad_primary"
                android:gravity="center"
                android:text="@string/btn_quick_float"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnQuickFloat"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="@string/btn_full_screen"
                    android:textColor="@color/text_main"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="@string/btn_save"
                    android:textColor="@color/text_main"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="@string/btn_share"
                    android:textColor="@color/text_sub"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
